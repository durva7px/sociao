// Database schema. Models are added feature by feature, test-first.
// Prisma 7: the connection URL lives in prisma.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A person with an identity in sociao. Created only at the end of Sign up (D-011).
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique // always stored trimmed and lowercased (D-014)
  username     String    @unique
  passwordHash String
  avatarUrl    String? // optional; the UI falls back to initials (D-026)
  bio          String? // optional, at most 150 characters (CHECK in migration, D-031)
  createdAt    DateTime  @default(now())
  sessions     Session[]
  posts        Post[]
  likes        Like[]
  following    Follow[]  @relation("follower") // Follows this User made
  followers    Follow[]  @relation("followee") // Follows pointing at this User
}

// Proof that requests come from a logged-in User. Its id lives in an httpOnly cookie (D-005).
model Session {
  id        String   @id // random, unguessable; generated by the app
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime // 7 days after Log in (D-016)
  createdAt DateTime @default(now())

  @@index([userId])
}

enum MediaType {
  IMAGE
  VIDEO
}

// Something a User publishes: a Caption plus optional Media (D-003, D-026).
// Database CHECKs (added in the migration SQL): caption is 1-1000 characters,
// and mediaType / mediaUrl are both set or both empty.
model Post {
  id        String     @id @default(cuid())
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  caption   String
  mediaType MediaType?
  mediaUrl  String?
  viewCount Int        @default(0) // only meaningful for Video Posts (D-031); CHECK >= 0
  createdAt DateTime   @default(now())
  likes     Like[]

  @@index([createdAt, id]) // newest-first Feed paging (D-028)
}

// One User liking one Post. The composite key makes a second Like impossible (FEED-06).
// likeCount and likedByMe are computed from these rows, never stored (D-026).
model Like {
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([postId])
}

// One User following another (D-031). One-way: following back is a second row.
// The composite key stops double-following; a CHECK in the migration stops self-follows.
model Follow {
  followerId String
  followeeId String
  follower   User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee   User     @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([followerId, followeeId])
  @@index([followeeId])
}
